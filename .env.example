# =============================================================================
# SALE ANALYTICS — SECURE ENVIRONMENT CONFIGURATION
# =============================================================================

# AI Studio injected runtime variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# 1. FRONTEND / CLIENT CONFIGURATION (Publishable / Anon ONLY)
# -----------------------------------------------------------------------------
# CRITICAL SECURITY RULE:
# Variables starting with VITE_ are bundled into client-side JavaScript.
# NEVER place secret keys ("sb_secret_..."), service_role keys, or database
# passwords in VITE_ variables!

# Supabase Project URL
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# Supabase Client Public Key (Use either modern publishable key or legacy anon key)
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"

# Optional: Supabase Project Reference ID
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"

# -----------------------------------------------------------------------------
# 2. BACKEND / SERVER-SIDE CONFIGURATION (Privileged Keys ONLY)
# -----------------------------------------------------------------------------
# Server-side variables do NOT use the VITE_ prefix and are strictly isolated
# from the browser. They are accessed only by server.ts for administrative tasks.
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVER_ONLY_SERVICE_ROLE_KEY"
